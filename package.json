{
  "name": "taskflow-front-end",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "generate:api": "openapi-typescript http://localhost:8000/api/v1/openapi.json -o src/services/generated/api-types.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
